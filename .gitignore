# Corpus — not redistributed. data/* (not data/) ignores the folder's
# contents, so the ! lines below can re-include single files; git cannot
# re-include a file inside an ignored folder.
data/*

# Secrets
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# OS / editor
.DS_Store
.idea/
.vscode/

